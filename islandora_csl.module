<?php

/**
 * @file
 * Contains islandora_csl.module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Seboettg\CiteProc\StyleSheet;
use Seboettg\CiteProc\CiteProc;

/**
 * Implements hook_theme().
 */
function islandora_csl_theme() {
  return [
    'csl' => [
      'variables' => [
        'csl' => NULL,
        'title' => NULL,
      ],
    ],
    'csl_client' => [
      'variables' => [
        'csl_json' => NULL,
        'csl_style' => 'citation-apa',
        'title' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_entity_extra_field_info().
 */
function islandora_csl_entity_extra_field_info() {
  $extra_field = [];
  $bundles = [
    // entity_type => [bundle1, bundle2].
    'node' => [
      'islandora_object',
    ],
  ];
  foreach ($bundles as $entity_type => $bundles) {
    foreach ($bundles as $bundle) {
      $extra_field[$entity_type][$bundle]['display']['field_islandora_csl'] = [
        'label' => t('Citation'),
        'description' => t('The generated citation'),
        'weight' => 100,
        'visible' => TRUE,
      ];
    }
  }

  return $extra_field;
}

/**
 * Implements hook_entity_base_field_info().
 */
function islandora_csl_entity_base_field_info(EntityTypeInterface $entity_type) {
  $fields = [];
  if ($entity_type->id() == 'node') {
    $fields['citation'] = BaseFieldDefinition::create('string')
      ->setLabel(t('Citation (Hidden field for JSON support)'))
      ->setDescription(t('The computed citation for the entity.'))
      ->setComputed(TRUE)
      ->setTranslatable(TRUE)
      ->setReadOnly(TRUE)
      ->setSettings([
        'max_length' => 4096,
      ])
      ->setTargetEntityTypeId($entity_type->id())
      ->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)
      ->setClass('\Drupal\islandora_csl\Plugin\Field\FieldType\CitationFieldItemList');
  }

  return $fields;
}

/**
 * Implements hook_entity_view().
 */
function islandora_csl_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  $route_match_item = \Drupal::routeMatch()->getParameters()->get($entity->getEntityTypeId());
  // Ensure the entity matches the route.
  if ($entity === $route_match_item) {
    // @todo if you want other bundles than islandora object, check that here.
    if ($entity->bundle() == 'islandora_object'
      && $display->getComponent('field_islandora_csl')) {
      $entity_array = $entity->toArray();
      $encoder = \Drupal::service('islandora_csl.encoder');
      $csl_str = $encoder->encode($entity_array);

      $config = \Drupal::config('islandora_csl.settings');
      $render_mode = $config->get('render_mode') ?? 'server';

      if ($render_mode === 'client') {
        // Client-side rendering: pass CSL-JSON to JavaScript.
        $build['field_islandora_csl'] = [
          '#theme' => 'csl_client',
          '#title' => "Citation",
          '#csl_json' => $csl_str,
          '#csl_style' => $config->get('csl_style') ?? 'citation-apa',
          '#attached' => [
            'library' => ['islandora_csl/citation-js'],
          ],
        ];
      }
      else {
        // Server-side rendering: use CiteProc PHP library.
        $csl = [json_decode($csl_str)];
        $style = StyleSheet::loadStyleSheet("modern-language-association");
        $citeProc = new CiteProc($style);
        $mla = $citeProc->render($csl, "bibliography");

        $build['field_islandora_csl'] = [
          '#theme' => 'csl',
          '#title' => "Citation",
          '#csl' => $mla,
        ];
      }
    }
  }
}
